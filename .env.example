# Environment Variables Example for ToolNova

# Server Configuration
PORT=3000
NODE_ENV=development
# Public origin used by secure launchers to contact the server API (without trailing slash)
PUBLIC_BASE_URL=http://localhost:3000

# 256-bit Server Master Key for envelope encryption (exactly 64 hex characters)
# In production, server will refuse to start if this is missing.
# Generate in terminal: openssl rand -hex 32
SERVER_MASTER_KEY=
# Key identifier for key rotation tracking
SERVER_MASTER_KEY_ID=k1

# Gemini API Key (server-side)
GEMINI_API_KEY=

# Firebase Configuration (defaults are loaded from firebase-applet-config.json)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
