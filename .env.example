# Environment Variables Example for ToolNova

# Server Configuration
# HTTP port the Express server listens on (default: 3000)
PORT=3000
# Runtime environment mode: development | production | test
NODE_ENV=development
# Public origin used by secure launchers to contact the server API without trailing slash
PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins (required in production)
ALLOWED_ORIGINS=http://localhost:3000
# Express trust proxy setting: true, false, hop count, or subnet (default: false)
TRUST_PROXY=false
# Set to a non-empty value in dev to skip setting X-Frame-Options when testing embedded iframes
CSP_HEADER_VALUE=
# Directory path where encrypted protector vault blobs are stored (default: .secure_storage)
STORAGE_DIR=.secure_storage
# Disable Vite HMR and file watching when set to "true"
DISABLE_HMR=false

# Security & Envelope Encryption
# Secret salt for privacy-preserving SHA-256 audit IP hashing (required in production)
AUDIT_IP_SALT=
# 256-bit Server Master Key for envelope encryption: 64 hex chars, e.g. `openssl rand -hex 32` (required in production)
SERVER_MASTER_KEY=
# Active master key identifier for key rotation tracking (alphanumeric/underscore/hyphen, max 32 chars)
SERVER_MASTER_KEY_ID=k1

# Firebase & Firestore Configuration (falls back to firebase-applet-config.json when unset)
# Firebase project ID used by firebase-admin on the server
FIREBASE_PROJECT_ID=
# Named Firestore database ID used by firebase-admin on the server
FIRESTORE_DATABASE_ID=
# Client-side Firebase Web API key
VITE_FIREBASE_API_KEY=
# Client-side Firebase Auth domain
VITE_FIREBASE_AUTH_DOMAIN=
# Client-side Firebase project ID (also used as fallback for FIREBASE_PROJECT_ID)
VITE_FIREBASE_PROJECT_ID=
# Client-side Firestore named database ID (also used as fallback for FIRESTORE_DATABASE_ID)
VITE_FIREBASE_DATABASE_ID=
# Client-side Firebase Storage bucket
VITE_FIREBASE_STORAGE_BUCKET=
# Client-side Firebase Cloud Messaging sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Client-side Firebase Web App ID
VITE_FIREBASE_APP_ID=
# Optional reCAPTCHA v3 site key for Firebase App Check in the browser
VITE_RECAPTCHA_SITE_KEY=

# Client Media Limits
# Maximum client-side video/audio upload size in MB for Video & AI Hub (default: 500)
VITE_MAX_VIDEO_FILE_MB=500

# Lemon Squeezy Billing & Entitlements
# Lemon Squeezy webhook signing secret for HMAC-SHA256 verification (required in production)
LEMONSQUEEZY_WEBHOOK_SECRET=
# Comma-separated Lemon Squeezy variant IDs mapped to the Pro plan
LEMONSQUEEZY_PRO_VARIANT_IDS=
# Comma-separated Lemon Squeezy variant IDs mapped to the Enterprise plan
LEMONSQUEEZY_ENTERPRISE_VARIANT_IDS=
# Public Lemon Squeezy storefront URL opened from pricing/upgrade modals
VITE_LEMONSQUEEZY_STORE_URL=
# Optional direct Lemon Squeezy checkout URL override for Pro upgrades
VITE_LEMONSQUEEZY_CHECKOUT_URL=
